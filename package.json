{
  "name": "node-pushnotifications",
  "description": "A cross-platform push service for node.js",
  "version": "6.0.2",
  "author": {
    "name": "AppFeel",
    "email": "info@appfeel.com"
  },
  "scripts": {
    "coveralls": "cat ./coverage/lcov.info | coveralls",
    "test-cover": "nyc --reporter=lcov mocha test/ -- --require @babel/register --recursive; open-cli ./coverage/lcov-report/index.html",
    "test": "mocha test/ --require @babel/register --recursive",
    "build": "./node_modules/.bin/babel src -d lib",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "ci": "npm run build && npm run test-cover && npm run lint",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "release": "release-it",
    "lint:fix": "eslint . --fix && prettier --write ."
  },
  "keywords": [
    "notifications",
    "push",
    "push notifications",
    "apple",
    "ios",
    "iphone",
    "ipad",
    "apns",
    "google",
    "android",
    "gcm",
    "fcm",
    "amazon",
    "kindle",
    "adm",
    "microsoft",
    "windows",
    "wphone",
    "windows phone",
    "wns",
    "mpns",
    "webpush"
  ],
  "main": "index.js",
  "bugs": {
    "url": "https://github.com/appfeel/node-pushnotifications",
    "email": "info@appfeel.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/appfeel/node-pushnotifications.git"
  },
  "dependencies": {
    "@parse/node-apn": "8.2.0",
    "firebase-admin": "13.10.0",
    "node-adm": "0.9.1",
    "web-push": "3.6.7",
    "wns": "0.5.4"
  },
  "devDependencies": {
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.13",
    "@babel/preset-env": "7.29.14",
    "@babel/register": "7.29.13",
    "@eslint/js": "10.0.1",
    "chai": "6.3.0",
    "coveralls": "3.1.1",
    "dirty-chai": "3.0.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-mocha": "12.0.2",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-promise": "7.3.0",
    "globals": "17.14.0",
    "mocha": "12.0.3",
    "nyc": "18.0.0",
    "open-cli": "9.0.0",
    "prettier": "3.10.1",
    "release-it": "21.1.3",
    "sinon": "1.17.7",
    "sinon-chai": "3.5.0"
  },
  "engines": {
    "node": ">=20.x.x"
  },
  "readmeFilename": "README.md",
  "homepage": "https://github.com/appfeel/node-pushnotifications",
  "license": "MIT",
  "contributors": [
    {
      "name": "Alexander Friedl",
      "email": "mail@alexanderfriedl.com",
      "url": "https://github.com/alex-friedl"
    }
  ]
}
